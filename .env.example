# ===== Qwen / DashScope (OpenAI-compatible mode) =====
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Quoc te: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Trung Quoc: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_ROUTER_MODEL=qwen-plus
QWEN_EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3
# Ghi nguyên văn prompt + trả lời của từng lệnh gọi LLM ra data/trace/*.jsonl.
# Đọc bằng: python scripts/trace.py --help. Đặt 0 để tắt.
TRACE_LLM=1

# ===== App =====
APP_HOST=127.0.0.1
APP_PORT=8000
DOMAIN_ID=vinhomes
DB_PATH=./data/demo.db
CHROMA_PATH=./data/chroma

# ===== MCP =====
MCP_KY_THUAT_URL=http://127.0.0.1:8101/mcp
MCP_PORT=8101
# Mỗi bên tham gia một MCP server riêng (an ninh, vệ sinh, nhà thầu ngoài...)
MCP_AN_NINH_URL=http://127.0.0.1:8102/mcp
MCP_AN_NINH_PORT=8102
MCP_VE_SINH_URL=http://127.0.0.1:8103/mcp
MCP_VE_SINH_PORT=8103

# ===== RAG =====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
RAG_MAX_DISTANCE=1.2

# ===== Builder / Evaluator (Phase 8-9) =====
# Để trống thì lấy bằng QWEN_CHAT_MODEL. Riêng QWEN_JUDGE_MODEL: để trống sẽ cảnh báo
# "judge dùng chung model với agent, kết quả kém tin cậy" vì ưu tiên model khác/mạnh hơn.
# Mỗi agent quản trị một biến — Evaluator dùng cùng model cho cả sinh case lẫn
# judge. Để trống thì rơi về QWEN_CHAT_MODEL kèm cảnh báo trong log (judge chấm
# bằng chính model đang được chấm sẽ kém tin cậy hơn một giám khảo độc lập).
QWEN_BUILDER_MODEL=
QWEN_EVALUATOR_MODEL=
BUILDER_OVERLAP_THRESHOLD=0.85
BUILDER_MAX_ITERATIONS=2
EVAL_CASES_PER_AGENT=6
EVAL_CONCURRENCY=2
EVAL_JUDGE_MIN=3
EVAL_ROUTER_REPEATS=2
EVAL_REGRESSION_MAX_DROP=0
# Số case LẤY MẪU tối đa mỗi agent khi chạy regression (không phải tổng số case của
# agent đó) — chặn trần chi phí, tránh regression ngày càng chậm khi domain tích
# lũy thêm case theo thời gian. Ưu tiên case viết tay trước.
EVAL_REGRESSION_MAX_CASES_PER_AGENT=3

# ===== Room =====
# maf = Microsoft Agent Framework GroupChat | builtin = vòng lặp tự viết
ROOM_ENGINE=maf
MAX_TOOL_ITERATIONS=4
MAX_AGENT_TOOLS=10

# ===== HITL (duyệt của quản lý) =====
# 1 = phòng họp DỪNG ngay tại lượt gọi tool cần duyệt, chỉ chạy tiếp khi quản lý
# duyệt hoặc từ chối. 0 = hành vi cũ: tạo hành động chờ duyệt rồi họp tiếp.
HITL_WAIT_FOR_APPROVAL=1
# Chờ quá số giây này mà không ai quyết định thì phòng họp chạy tiếp; hành động
# vẫn nằm ở hàng chờ và duyệt muộn vẫn thực thi (ngoài phiên họp).
HITL_APPROVAL_TIMEOUT=600
# Trần thời gian API duyệt đợi phòng họp chạy xong tool để trả kết quả về giao diện.
HITL_EXECUTE_TIMEOUT=120

# ===== Tiếp nhận (Lễ tân) =====
# Người báo nhắn quá số lượt này mà vẫn thiếu trường bắt buộc thì Lễ tân mở phản
# ánh với thông tin đã có, thay vì hỏi tiếp — chặn vòng hỏi vô hạn của model nhỏ.
INTAKE_MAX_TURNS=3
# Số lần tối đa phòng họp được quay lại hỏi người báo trên cùng một phản ánh.
# Quá trần thì guard bỏ câu hỏi và buộc agent kết luận với thông tin đang có.
MAX_FOLLOWUP_ROUNDS=2
